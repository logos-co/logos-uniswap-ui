// QtRO view contract for the Uniswap app.
//
// There is deliberately NO password parameter anywhere below, and there never may be. This
// UI quotes swaps and asks the sender to make them; the human's approval is taken by
// evm_signer_ui, and key material only ever reaches evm_keystore_ui. CI asserts the absence.
//
// Everything crosses as a JSON string rather than a typed record, matching the modules' own
// contracts — the UI is a renderer, and a second schema here would be a second place for the
// two to disagree.
class UniswapUi
{
    PROP(QString lastError="" READONLY)
    // Errors from the swap path only. The Swap page renders them beside the button, where the
    // user is looking; the wallet-wide line above the tabs is for reads that failed.
    PROP(QString swapError="" READONLY)

    // Whether the account-and-chain-scoped values below were read under the selection also
    // published here. False the moment either moves, and true again only once a read made
    // under the new one lands: the view renders no scoped figure while it is false.
    PROP(bool scopedDataFresh=false READONLY)
    // A balances+swaps read is outstanding. A value that is BOTH unknown and being read
    // spins; one that is unknown and idle is an em-dash.
    PROP(bool dataLoading=false READONLY)
    PROP(bool quoteLoading=false READONLY)
    PROP(bool catalogueLoading=false READONLY)
    PROP(bool feeTiersLoading=false READONLY)
    // A poll of the swap awaiting approval is outstanding. `send_status` IS the broadcast,
    // so a poll can take a few seconds; two must not overlap.
    PROP(bool swapPolling=false READONLY)

    // { chainId, key, name, nativeSymbol, testnet, … } — the wallet backend's active network.
    // This app never moves it; the wallet's Networks screen does, and this view follows.
    PROP(QString activeNetworkJson="{}" READONLY)
    PROP(QString networksJson="[]" READONLY)
    // eth_rpc's verdict for the active chain, via the wallet backend:
    // { ok, chainId, mode, state, usable, blocking, message, action, detail }.
    PROP(QString verifiedProxyJson="{}" READONLY)

    PROP(QString accountsJson="[]" READONLY)
    PROP(QString selectedAccount="" READONLY)
    PROP(QString accountLabelsJson="{}" READONLY)
    PROP(QString accountWalletsJson="{}" READONLY)

    // The tokens the wallet shows on the active chain: `[{ symbol, name, decimals, address?,
    // native?, source? }]`. EMPTY means "not read yet"; the previous network's symbols are
    // not an answer about this one.
    PROP(QString tokensJson="" READONLY)
    // Balances for the selected account on the active network, one row per enabled token.
    // EMPTY means "not read yet", which the view renders as an em-dash — never as a zero.
    PROP(QString balancesJson="" READONLY)
    PROP(QString balancesRoute="" READONLY)
    // The last list_available_tokens answer, VERBATIM: { ok, chainId, total, shown, listed,
    // tokens, listError? }. Chain-tagged, and the picker renders it only for the active chain.
    PROP(QString catalogueJson="" READONLY)

    // { baseFeePerGas, source, tiers: { slow, normal, fast } }, from fee_module via the wallet.
    PROP(QString feeTiersJson="{}" READONLY)

    // The last quote: uniswap_module's build_swap reply (amounts, route, price impact, the
    // calls) with tx_sender_module's prepare reply under `fee` (the ceiling, the nonce).
    // Withdrawn with every other scoped figure.
    PROP(QString quoteJson="{}" READONLY)
    // The request those figures priced. The Swap page renders them only while this still
    // equals the request the form describes: a quote for another request is not stale, it is
    // about a form that is no longer on screen.
    PROP(QString quoteRequestJson="" READONLY)
    // The last automatic re-quote failed; the previous figures stand, and the view says so.
    PROP(bool quoteStale=false READONLY)

    // { slippageBps, autoSlippage, deadlineMins }. Held for the session; nothing here persists.
    PROP(QString settingsJson="{\"slippageBps\":50,\"autoSlippage\":true,\"deadlineMins\":30}" READONLY)

    // The swap awaiting a human. Empty when nothing is in flight. Deliberately NOT withdrawn
    // by a selection change: it is a request sitting in the signer, not a figure on screen.
    PROP(QString pendingRequestId="" READONLY)
    // The keystore's name for the same request, for pointing a signer at it. Empty exactly
    // when `pendingRequestId` is.
    PROP(QString pendingApprovalHandle="" READONLY)
    // How the last swap ended: `{ status, hash?, hashes?, reason? }`, or empty before the
    // first one. Set as `pendingRequestId` clears, because that is the instant the waiting
    // dialog disappears — the shell may be returning the user here at exactly that moment.
    PROP(QString lastSwapOutcomeJson="" READONLY)

    // This app's own swaps on the selected account and network, newest first, one entry per
    // bundle: `[{ requestId, status, timestamp, hashes, legs: [rows], swap: meta, label }]`.
    // Read off tx_sender_module's history and grouped here. EMPTY means "not read yet".
    PROP(QString swapsJson="" READONLY)
    // True while a swap of this app's is still pending and the receipt sweep is scheduled.
    PROP(bool sweepingReceipts=false READONLY)

    SLOT(void refresh())
    SLOT(void selectAccount(QString address))
    // Search the catalogue offered on the active chain. The query goes to the wallet
    // backend: the embedded Uniswap list is thousands of rows.
    SLOT(void searchTokens(QString query))
    // Price a swap without side effects — safe to call on every edit.
    SLOT(void quote(QString requestJson))
    // Re-price the open Swap page on a timer. Off while it is not on screen.
    SLOT(void setQuoteAutoRefresh(bool on))
    SLOT(void setSettings(QString settingsJson))
    // Build the swap and ask the sender to make it. Returns nothing signed; the sender asks
    // the keystore, the keystore asks a human. Poll with pollSwap().
    SLOT(void submitSwap(QString requestJson))
    SLOT(void pollSwap())
    SLOT(void cancelSwap())
    // Re-read this app's swaps for the selected account.
    SLOT(void refreshSwaps())
    // Sweep the selected account's still-pending transactions for receipts.
    SLOT(void refreshPending())
}
